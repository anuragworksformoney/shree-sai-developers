# ==============================================================================
# SHREE SAI DEVELOPERS - Environment Configuration Template
# ==============================================================================
# For Vercel Deployment:
# Add these variables under: Vercel Dashboard -> Project Settings -> Environment Variables
# For Local Development:
# Copy this file to .env and fill in your development values.
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=production

# Lead Routing & Enquiry Notifications (Recipients)
DESTINATION_EMAIL=shreesaideveloper.in@gmail.com
FALLBACK_DESTINATION_EMAIL=ssdofficial0001@gmail.com

# Admin Portal Authentication Credentials
# Access admin dashboard at /admin or by clicking the lock icon
ADMIN_EMAIL=ssdofficial0001@gmail.com
ADMIN_PASSWORD=SaiDev@2026
ADMIN_SECRET=shree-sai-developers-admin-secret-key-2026

# Email Dispatcher Options (Configure at least one for automated email alerts)
# Option 1: Gmail SMTP (Requires 16-character Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
GMAIL_APP_PASSWORD=

# Option 2: Resend API (https://resend.com)
RESEND_API_KEY=

# Option 3: Web3Forms (https://web3forms.com)
WEB3FORMS_ACCESS_KEY=

# Supabase Persistent Cloud Storage & Database (Recommended for Vercel production)
# Get these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend Client Supabase Variables (Must start with VITE_ to be exposed to browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
