# Dependencies
node_modules
.pnp
.pnp.js

# Production build outputs
dist
dist-ssr
build
*.local

# Vercel deployment artifacts
.vercel

# Environment variables & secrets (CRITICAL: Never commit secrets)
.env
.env.*
!.env.example
*.pem
*.key

# Editor & OS files
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# AI Studio and local scratch
.aistudio
assets/.aistudio

# Local runtime data and uploads (protects runtime persistence from accidental Git commits)
data/*.json
!data/.gitkeep
public/uploads/properties/*
!public/uploads/properties/.gitkeep
